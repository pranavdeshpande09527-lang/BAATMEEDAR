# =============================================================
# server/.env.example — Baatmeedar Backend Environment
# Copy to server/.env and fill in your own values.
# Never commit .env to version control.
# =============================================================

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5500

# ── Supabase (Database & Auth) ────────────────────────────
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ── AI Providers ──────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>
XAI_API_KEY=<your-xai-grok-api-key>

# ── Research & Retrieval ──────────────────────────────────
TAVILY_API_KEY=<your-tavily-api-key>
YOUTUBE_API_KEY=<your-youtube-api-key>

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>

# ── Rate Limits (optional, defaults used if omitted) ──────
# RATE_LIMIT_VERIFY_MAX=10
# RATE_LIMIT_VERIFY_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW_MS=60000

# ── Guest Sessions (optional) ────────────────────────────
# GUEST_SESSION_TTL_SECONDS=86400
