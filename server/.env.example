# =============================================================
# Baatmeedar Backend — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# =============================================================

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Supabase ──────────────────────────────────────────────────
# Project URL — connects backend to Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Anon/publishable key — used for client-scoped operations
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Service-role key — BACKEND ONLY, full DB access, keep secret
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Direct Postgres connection string — BACKEND ONLY, keep secret
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ── AI Providers ──────────────────────────────────────────────
# Gemini — Stage 2 claim extraction, Stage 3 analysis, Stage 4 verification
GEMINI_API_KEY=<your-gemini-api-key>
# Groq — Stage 3 supporting analysis AND Stage 4 independent verification
GROQ_API_KEY=<your-groq-api-key>

# ── Research & Retrieval ──────────────────────────────────────
# Tavily — web search and source discovery
TAVILY_API_KEY=<your-tavily-api-key>
# YouTube — transcript retrieval
YOUTUBE_API_KEY=<your-youtube-api-key>

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins (do NOT use wildcard with credentials)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Rate Limits ───────────────────────────────────────────────
# Verify endpoint: max requests per window
RATE_LIMIT_VERIFY_MAX=10
RATE_LIMIT_VERIFY_WINDOW_MS=60000
# Auth endpoints: max requests per window
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000

# ── Guest Sessions ────────────────────────────────────────────
# TTL in seconds (default: 24 hours)
GUEST_SESSION_TTL_SECONDS=86400

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
